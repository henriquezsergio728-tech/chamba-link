# Copy to /etc/chambalink/controller.env (root, mode 600). The three values below are placeholders.
CONTROLLER_NLB_ID=example-network-load-balancer-id
CONTROLLER_BACKEND_SET=example-backend-set
CONTROLLER_BACKEND_NAME=example-second-node-backend

# Optional tuning. The values shown are the defaults.
#CONTROLLER_SAMPLE_SECONDS=5
#CONTROLLER_SCALE_OUT_THRESHOLD=0.70
#CONTROLLER_SCALE_OUT_WINDOW_SECONDS=30
#CONTROLLER_SCALE_IN_THRESHOLD=0.30
#CONTROLLER_SCALE_IN_WINDOW_SECONDS=300
#CONTROLLER_COOLDOWN_SECONDS=120
#CONTROLLER_REFRESH_SECONDS=30
#CONTROLLER_WORK_REQUEST_TIMEOUT_SECONDS=120
#CONTROLLER_WORK_REQUEST_POLL_SECONDS=5
#CONTROLLER_BACKOFF_BASE_SECONDS=5
#CONTROLLER_BACKOFF_MAX_SECONDS=300

# Demo profile: shortens the scale-in window to 60 s and changes nothing else.
# It cannot be combined with CONTROLLER_SCALE_IN_WINDOW_SECONDS.
#CONTROLLER_PROFILE=demo
